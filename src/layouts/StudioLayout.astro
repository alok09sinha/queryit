---
interface Props {
    title?: string;
}

const { title = "QueryIT Studio" } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>

</head>

<body style="margin:0;background:#08111f;">

    <slot />

</body>

</html>