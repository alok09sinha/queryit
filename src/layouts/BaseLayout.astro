---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "QueryIT | Think Like a Network Architect",
  description = "Built from Real Enterprise Deployments. Practical Networking, Security, Cloud and Automation."
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>

  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

  <title>{title}</title>

  <meta
    name="description"
    content={description}
  />

  <meta
    name="author"
    content="QueryIT"
  />

  <meta
    name="keywords"
    content="Networking,Cisco,Palo Alto,Azure,AWS,SD-WAN,Zscaler"
  />

  <meta
    name="theme-color"
    content="#050816"
  />

  <link rel="icon" href="/favicon.svg" />

  <link
    rel="preconnect"
    href="https://fonts.googleapis.com"
  />

  <link
    rel="preconnect"
    href="https://fonts.gstatic.com"
    crossorigin
  />

  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
    rel="stylesheet"
  />

</head>

<body>

  <slot />

</body>

</html>